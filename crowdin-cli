#!/usr/bin/env php
<?php

declare(strict_types=1);

use DI\ContainerBuilder;
use FriendsOfTYPO3\CrowdinBase\Command\SetupCommand;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Command\Command;
use TYPO3\CrowdinCli\Command\InteractiveCommand;
use TYPO3\CrowdinCli\Command\ProjectContributorsCommand;
use TYPO3\CrowdinCli\Command\ProjectProofreadersCommand;
use TYPO3\CrowdinCli\Command\ProjectsListCommand;
use TYPO3\CrowdinCli\Command\ProjectStatusCommand;
use TYPO3\CrowdinCli\Command\TranslationsApproveCommand;
use TYPO3\CrowdinCli\Command\TranslationsDedupeCommand;
use TYPO3\CrowdinCli\Command\TranslationsDownloadCommand;
use TYPO3\CrowdinCli\Command\TranslationsUndoCommand;
use TYPO3\CrowdinCli\Command\TranslationsUploadCommand;
use TYPO3\CrowdinCli\Command\TranslationsUnapprovedCommand;
use TYPO3\CrowdinCli\Service\ApprovalLog;

// vendor libraries still call functions deprecated in PHP 8.5
error_reporting(E_ALL & ~E_DEPRECATED);

require __DIR__ . '/vendor/autoload.php';

// Reuse the container definitions (settings, Crowdin client, configuration reader/writer) of crowdin-base
$basePath = \Composer\InstalledVersions::getInstallPath('friendsoftypo3/crowdin-base');
$containerBuilder = new ContainerBuilder();
$containerBuilder->addDefinitions($basePath . '/config/container.php');
// Approvals made by this tool are logged here, to be able to revoke them
$containerBuilder->addDefinitions([
    ApprovalLog::class => \DI\autowire()->constructorParameter('file', __DIR__ . '/var/approvals.log'),
]);
$container = $containerBuilder->build();

$app = new Application('Crowdin-CLI', '1.0');
foreach ([
    SetupCommand::class,
    ProjectsListCommand::class,
    ProjectStatusCommand::class,
    ProjectProofreadersCommand::class,
    ProjectContributorsCommand::class,
    TranslationsUnapprovedCommand::class,
    TranslationsApproveCommand::class,
    TranslationsUndoCommand::class,
    TranslationsDedupeCommand::class,
    TranslationsDownloadCommand::class,
    TranslationsUploadCommand::class,
    InteractiveCommand::class,
] as $command) {
    /** @var Command $instance */
    $instance = $container->get($command);
    $app->addCommand($instance);
}
$app->run();
