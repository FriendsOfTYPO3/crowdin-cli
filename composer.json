{
  "name": "friendsoftypo3/crowdin-cli",
  "description": "CLI for Crowdin in the context of TYPO3",
  "type": "project",
  "bin": [
    "crowdin-cli"
  ],
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Xavier Perseguers",
      "email": "xavier@typo3.org"
    }
  ],
  "support": {
    "issues": "https://github.com/FriendsOfTYPO3/crowdin-cli/issues",
    "source": "https://github.com/FriendsOfTYPO3/crowdin-cli"
  },
  "config": {
    "bin-dir": "bin",
    "platform": {
      "php": "8.5"
    },
    "sort-packages": true
  },
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-zip": "*",
    "crowdin/crowdin-api-client": "^1.26",
    "friendsoftypo3/crowdin-base": "^0.2.1",
    "symfony/console": "^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.89.2",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13.4"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/FriendsOfTYPO3/crowdin-base"
    }
  ],
  "autoload": {
    "psr-4": {
      "TYPO3\\CrowdinCli\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TYPO3\\CrowdinCli\\Tests\\": "tests"
    }
  },
  "scripts": {
    "all": [
      "@csfix",
      "@stan",
      "@tests"
    ],
    "cs": [
      "./bin/php-cs-fixer fix -v --dry-run --config .build/php-cs-fixer.php"
    ],
    "csfix": [
      "./bin/php-cs-fixer fix --config .build/php-cs-fixer.php"
    ],
    "stan": [
      "./bin/phpstan"
    ],
    "tests": [
      "./bin/phpunit"
    ]
  }
}
